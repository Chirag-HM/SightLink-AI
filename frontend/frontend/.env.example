# SightLink AI Frontend — Environment Placeholders
# Copy to .env.local and fill in values as needed. Never commit secrets.

# Leave VITE_API_BASE / VITE_WS_BASE unset (blank) for local Vite dev/preview so
# requests stay same-origin via vite.config.js proxy and preserve httpOnly + CSRF cookies.
# Only set these if deploying the frontend on a separate domain with CORS configured.
# VITE_API_BASE=http://localhost:8000
# VITE_WS_BASE=ws://localhost:8000
# VITE_PROXY_TARGET=http://127.0.0.1:8000

VITE_ESP8266_URL=http://10.235.17.89
VITE_ESP32_CAM_URL=http://10.235.17.135/capture

# Map Provider (optional; defaults to OpenStreetMap / CARTO Dark Matter tiles when empty)
VITE_MAP_TILE_URL=
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_KEY=

# Web Push / VAPID & Firebase Cloud Messaging (optional)
VITE_VAPID_PUBLIC_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Google Sign-In & Free Telegram Bot Placeholders
VITE_GOOGLE_CLIENT_ID=
VITE_TELEGRAM_BOT_USERNAME=

# WebRTC STUN / TURN Placeholders for Eyes on Demand
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Voice Assistant Configuration (all free defaults when blank)
VITE_DEFAULT_VOICE_LANG=en-IN
VITE_GEOCODER_URL=
VITE_ROUTING_URL=
VITE_BUS_CITY=Bengaluru
VITE_CLOUD_STT_ENABLED=false
VITE_CLOUD_TTS_ENABLED=false



