# SightLink AI — Backend & IoT Environment Variables
# Copy to .env and fill in secrets locally. Never commit real keys.

# Auth / JWT / Cookies / Google Sign-In
JWT_SECRET_KEY=
GOOGLE_CLIENT_ID=
COOKIE_SECURE=false
COOKIE_DOMAIN=
APP_PUBLIC_URL=http://localhost:5173

# Email Verification & Free Gmail SMTP Sending (App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=SightLink AI
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_COOLDOWN_SECONDS=60
EMAIL_OTP_DAILY_CAP=10

# Telegram Bot (Free via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_POLLING=false

# Database (defaults to ESP32_CAM_Test/volunteer_assistance.db if unset)
DATABASE_URL=

# IoT Hardware (ESP8266 Smart Stick & ESP32-CAM)
ESP8266_IP=10.235.17.89
ESP32_CAM_IP=10.235.17.135

# Volunteer Search, Escalation & Rate Limiting
DEFAULT_SEARCH_RADIUS_KM=0.5
ESCALATION_STEP_SECONDS=60
REQUEST_TIMEOUT_SECONDS=300
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600
SOS_RATE_LIMIT_MAX=5
SOS_RATE_LIMIT_WINDOW_SECONDS=300

# Web Push (VAPID Keys — generate via web-push or openssl)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@sightlink.example

# Firebase Cloud Messaging (optional background push)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Map Provider Placeholders (optional — OpenStreetMap/Leaflet is used when unset)
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Eyes on Demand (Live Video Assistance & Fallbacks)
LIVE_ASSIST_DEFAULT_SECONDS=30
LIVE_ASSIST_ESCALATION_STEP_SECONDS=15
LIVE_ASSIST_NO_JOIN_FALLBACK_SECONDS=45

# Privacy, Encryption at Rest & Calm Family Updates
# Generate Fernet key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOCATION_ENCRYPTION_KEY=
LOCATION_RETENTION_DAYS=7
LONG_STOP_MINUTES=10
ALERT_GROUP_WINDOW_SECONDS=300

# Optional Free Family Notification Webhooks (Leave blank for WebSocket + Web Push only)
SMS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
NTFY_TOPIC_URL=


