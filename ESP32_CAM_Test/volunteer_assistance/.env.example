FCM_SERVER_KEY=
FCM_PROJECT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@sightlink.example
ESP8266_IP=
ESP32_CAM_IP=
ESP32_CAM_URL=
DATABASE_URL=
DEFAULT_SEARCH_RADIUS_KM=0.5
ESCALATION_STEP_SECONDS=60
REQUEST_TIMEOUT_SECONDS=300
SOS_RATE_LIMIT_MAX=5
SOS_RATE_LIMIT_WINDOW_SECONDS=300
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
LIVE_ASSIST_DEFAULT_SECONDS=30
LIVE_ASSIST_ESCALATION_STEP_SECONDS=15
LIVE_ASSIST_NO_JOIN_FALLBACK_SECONDS=45
LOCATION_ENCRYPTION_KEY=
LOCATION_RETENTION_DAYS=7
LONG_STOP_MINUTES=10
ALERT_GROUP_WINDOW_SECONDS=300
SMS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
NTFY_TOPIC_URL=

# Voice Assistant: Geocoding & Walking Routing (Free Nominatim / Photon / OSRM default)
GEOCODER_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io/api
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/foot
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org/v2/directions/foot-walking

# Transit / Bus Feed Providers (auto | gtfs | bmtc | mock)
BUS_PROVIDER_MODE=auto
BUS_MOCK_ENABLED=true
MOCK_BUS_DATA_PATH=
GTFS_CITY_NAME=Bengaluru
GTFS_STATIC_ZIP_URL=
GTFS_STATIC_DIR=
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_TRIP_UPDATES_URL=
GTFS_API_KEY=
GTFS_API_KEY_HEADER=Authorization
BUS_CACHE_TTL_SECONDS=30

# Optional LLM Intent Fallback (app works completely without it)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional Cloud STT/TTS Adapter (disabled by default; Web Speech API used)
CLOUD_STT_ENABLED=false
CLOUD_TTS_ENABLED=false

# Optional Shared Token for Hardware Button WebSocket Clients
HARDWARE_BUTTON_TOKEN=

